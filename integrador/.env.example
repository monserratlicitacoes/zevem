# Integrador WhatsApp. Em produção, estas variáveis ficam em /opt/zevem/.env.production
# (ZEVEM_URL, DATA_DIR e PORT já vêm do compose.yaml).

PORT=3300
DATA_DIR=
# Backend do Zevem. Em produção: http://backend:3200 (rede interna do Docker).
ZEVEM_URL=http://127.0.0.1:3001
# O mesmo token definido no backend.
WHATSAPP_INTEGRACAO_TOKEN=

# Provedor ativo: meta (WhatsApp Cloud API) | simulado (testes locais, não envia nada).
WHATSAPP_PROVEDOR=meta

# ── Meta (WhatsApp Cloud API) ──
# Token permanente de um usuário do sistema do Business Manager, com whatsapp_business_messaging.
META_TOKEN=
# Id do número em WhatsApp > Configuração da API (não é o número de telefone).
META_PHONE_NUMBER_ID=
# Chave secreta do app (Configurações > Básico): valida a assinatura do webhook.
META_APP_SECRET=
# Texto livre, o mesmo informado ao configurar o webhook na Meta.
META_VERIFY_TOKEN=
META_GRAPH_VERSAO=v24.0

# ── Transcrição de áudio ──
# openai (qualquer API compatível com /audio/transcriptions) | nenhuma
TRANSCRICAO_PROVEDOR=nenhuma
TRANSCRICAO_URL=https://api.openai.com/v1
TRANSCRICAO_CHAVE=
TRANSCRICAO_MODELO=whisper-1

# ── Fila de avisos ──
FILA_INTERVALO_MS=60000
FILA_LIMITE=50
# 0 = sempre template, mesmo dentro da janela de 24h
JANELA_TEXTO_LIVRE=1
