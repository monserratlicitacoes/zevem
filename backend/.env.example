# Copie para .env e preencha os valores reais. Nunca commite o .env.

# Em produção: NODE_ENV=production. Com FRONTEND_URL fora de localhost o servidor também se trata
# como produção e não sobe sem JWT_SECRET (32+ caracteres) e DADOS_KEY (64 hex): openssl rand -hex 32
NODE_ENV=
PORT=3001
FRONTEND_URL=http://localhost:4300
JWT_SECRET=
# Produção: 64 caracteres hexadecimais. Guarde a chave para restaurar o banco.
DADOS_KEY=
DATA_DIR=

# Leitura de faturas em PDF e sugestão de item na importação (sem ela, só CSV/OFX).
ANTHROPIC_API_KEY=
# Também interpreta as mensagens do WhatsApp (lançamentos e consultas). Sem ela, o WhatsApp só lança
# o que o app já aprendeu e deixa o resto em suspenso.

# Integração com o WhatsApp (ver documentação da integração). Token longo e aleatório, compartilhado
# com o serviço do integrador. Sem ele, as rotas /integracao ficam desligadas e os avisos só são registrados.
WHATSAPP_INTEGRACAO_TOKEN=
# Modelo que interpreta as mensagens (padrão claude-opus-5-5; claude-haiku-5-5 é bem mais barato).
WHATSAPP_MODELO_IA=

# E-mail do sistema (confirmação de cadastro, nova senha, convites): caixa da Hostinger por SMTP.
# A senha é a da própria caixa de e-mail. EMAIL_REMETENTE padrão = SMTP_USER; EMAIL_NOME padrão = Zevem.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_REMETENTE=
EMAIL_NOME=Zevem

# Área master: e-mails (separados por vírgula) que entram como master ao subir o servidor.
MASTER_EMAILS=
# Assinaturas criadas pelo master (Master › Assinaturas): padrão "manual" (o master dá baixa nas parcelas).
# As vendas do checkout (/checkout) usam sempre o Asaas, com renovação e webhook próprios.
PAGAMENTOS_PROVEDOR=manual

# Asaas (checkout da página de venda). Sem a chave, o checkout mostra "pagamento indisponível".
# Chave em Asaas › Integrações › Chaves de API. Ambiente: sandbox (testes) ou producao.
# Em produção (docker compose), a chave vai entre aspas simples: ASAAS_API_KEY='$aact_...'
# Sem as aspas, o compose lê o "$" como variável e a chave chega cortada ao backend.
ASAAS_API_KEY=
ASAAS_AMBIENTE=sandbox
# Webhook no painel do Asaas: URL https://SEU_DOMINIO/api/pagamentos/webhook/asaas, eventos de cobrança,
# e o mesmo "Token de autenticação" informado aqui (texto longo e aleatório).
ASAAS_WEBHOOK_TOKEN=
