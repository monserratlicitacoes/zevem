# Copie para .env e preencha os valores reais. Nunca commite o .env.

PORT=3001
FRONTEND_URL=http://localhost:4300
JWT_SECRET=
DATA_DIR=

# Leitura de faturas em PDF e sugestão de item na importação (sem ela, só CSV/OFX).
ANTHROPIC_API_KEY=
# Também interpreta as mensagens do WhatsApp (lançamentos e consultas). Sem ela, o WhatsApp só lança
# o que o app já aprendeu e deixa o resto em suspenso.

# Integração com o WhatsApp (ver documentação da integração). Token longo e aleatório, compartilhado
# com o serviço do integrador. Sem ele, as rotas /integracao ficam desligadas e os avisos só são registrados.
WHATSAPP_INTEGRACAO_TOKEN=
# Modelo que interpreta as mensagens (padrão claude-opus-5-5; claude-haiku-5-5 é bem mais barato).
WHATSAPP_MODELO_IA=

# Área master: e-mails (separados por vírgula) que entram como master ao subir o servidor.
MASTER_EMAILS=
# Gateway de pagamento das assinaturas (padrão "manual": o master dá baixa nas parcelas).
# Ao escolher o gateway, implemente o adaptador em backend/pagamentos.js e informe o nome aqui.
PAGAMENTOS_PROVEDOR=manual
